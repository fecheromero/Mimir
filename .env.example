# LLM Provider ("anthropic" or "openai")
LLM_PROVIDER=anthropic

# Anthropic API (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Redis
REDIS_URL=redis://redis:6379

# Browser Execution ("local" or "cloud")
BROWSER_EXECUTION_MODE=local
# Required if BROWSER_EXECUTION_MODE=cloud
BROWSER_USE_API_KEY=your_browser_use_api_key_here

# SSO Configuration (optional for development)
SSO_PROVIDER=google  # google, auth0, okta
SSO_CLIENT_ID=your_sso_client_id
SSO_CLIENT_SECRET=your_sso_secret
SSO_REDIRECT_URI=http://localhost:8000/auth/callback

# Application
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# File cleanup (hours)
JOB_RETENTION_HOURS=24

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
